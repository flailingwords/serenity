{
    "dependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@fortawesome/fontawesome-free": "7.2.0",
        "@fortawesome/fontawesome-svg-core": "7.2.0",
        "@fortawesome/free-brands-svg-icons": "7.2.0",
        "@fortawesome/free-regular-svg-icons": "7.2.0",
        "@fortawesome/free-solid-svg-icons": "7.2.0",
        "@fortawesome/react-fontawesome": "3.3.0",
        "@headlessui/react": "2.2.10",
        "@heroicons/react": "2.2.0",
        "@tailwindcss/vite": "4.2.2",
        "clsx": "2.1.1",
        "debug": "4.4.3",
        "pretty-state-machine": "0.0.10",
        "react": "19.2.5",
        "react-dom": "19.2.5",
        "react-geolocated": "4.4.0",
        "react-interval-hook": "1.1.5",
        "react-markdown": "10.1.0",
        "serenity-shared": "workspace:*",
        "tailwindcss": "4.2.2",
        "unsplash-js": "7.0.20"
    },
    "devDependencies": {
        "@babel/eslint-parser": "7.28.6",
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
        "@eslint/js": "10.0.1",
        "@storybook/addon-docs": "10.3.5",
        "@storybook/addon-links": "10.3.5",
        "@storybook/addon-onboarding": "10.3.5",
        "@storybook/react-vite": "10.3.5",
        "@tailwindcss/vite": "4.2.2",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@tyisi/config-changelog": "3.0.0",
        "@tyisi/config-eslint": "6.0.0",
        "@tyisi/config-prettier": "5.0.0",
        "@tyisi/config-stylelint": "3.0.0",
        "@types/debug": "4.1.13",
        "@types/jest": "30.0.0",
        "@types/node": "24.12.2",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "6.0.1",
        "autoprefixer": "10.5.0",
        "eslint": "10.2.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-promise": "7.2.1",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.5.2",
        "eslint-plugin-storybook": "10.3.5",
        "generate-react-cli": "11.0.4",
        "globals": "17.5.0",
        "jest": "30.3.0",
        "postcss": "8.5.10",
        "prettier": "3.8.3",
        "prettier-plugin-sh": "0.18.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "sass": "1.99.0",
        "storybook": "10.3.6",
        "swr": "2.4.1",
        "tailwindcss": "4.2.2",
        "typescript": "~5.9.3",
        "typescript-eslint": "8.58.2",
        "vite": "8.0.8",
        "wireit": "0.14.12",
        "zod": "4.3.6"
    },
    "files": [
        "dist/"
    ],
    "name": "serenity-frontend",
    "private": true,
    "scripts": {
        "build": "wireit",
        "build:storybook": "wireit",
        "commit": "npx git-cz@latest",
        "create:component": "generate-react c",
        "create:widget": "generate-react c --type=widget",
        "dev": "wireit",
        "full-dev": "wireit",
        "hook:pre-push": "wireit",
        "lint": "wireit",
        "preinstall": "npx only-allow pnpm",
        "preview": "vite preview",
        "push": "wireit",
        "release": "wireit",
        "start": "wireit",
        "storybook": "wireit",
        "type-check": "wireit"
    },
    "type": "module",
    "version": "0.0.0",
    "wireit": {
        "build": {
            "command": "just build app",
            "dependencies": [
                "../shared:build",
                "type-check",
                "lint"
            ]
        },
        "build:storybook": {
            "command": "just build storybook"
        },
        "dev": {
            "dependencies": [
                "../shared:build"
            ],
            "command": "just dev",
            "service": true
        },
        "full-dev": {
            "dependencies": [
                "dev",
                "storybook"
            ]
        },
        "lint": {
            "command": "just lint"
        },
        "push": {
            "command": "just push",
            "dependencies": [
                "build"
            ]
        },
        "release": {
            "dependencies": [
                "release:version",
                "release:push"
            ]
        },
        "release:push": {
            "command": "just release push",
            "dependencies": [
                "release:version"
            ]
        },
        "release:version": {
            "command": "just release version"
        },
        "start": {
            "command": "just start",
            "service": true
        },
        "storybook": {
            "command": "just storybook",
            "service": true
        },
        "type-check": {
            "command": "just type-check"
        },
        "hook:pre-push": {
            "command": "just hook-pre-push"
        }
    }
}
