{
    "dependencies": {
        "@hono/node-server": "1.19.14",
        "@hono/zod-validator": "0.7.6",
        "@types/debug": "4.1.13",
        "debug": "4.4.3",
        "dotenv-flow": "4.1.0",
        "hono": "4.12.18",
        "serenity-shared": "workspace:*",
        "unsplash-js": "7.0.20",
        "wireit": "0.14.12",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
        "@tyisi/config-eslint": "6.0.0",
        "@tyisi/config-prettier": "5.0.0",
        "@types/node": "24.10.11",
        "eslint": "10.2.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jest": "29.15.2",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-promise": "7.2.1",
        "eslint-plugin-react": "7.37.5",
        "just-install": "2.0.2",
        "prettier": "3.8.3",
        "prettier-plugin-sh": "0.18.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "rust-just": "1.49.0",
        "tsup": "8.5.1",
        "tsx": "4.21.0",
        "typescript": "~5.9.3"
    },
    "files": [
        "dist/"
    ],
    "name": "serenity-backend",
    "private": true,
    "scripts": {
        "build": "wireit",
        "dev": "wireit",
        "lint": "wireit",
        "start": "node dist/index.cjs",
        "type-check": "wireit"
    },
    "type": "module",
    "wireit": {
        "build": {
            "dependencies": [
                "type-check"
            ],
            "command": "tsup --clean -d ./dist/ ./src/index.ts "
        },
        "dev": {
            "dependencies": [
                "../shared:build",
                "../frontend:build"
            ],
            "command": "tsx watch src/index.ts",
            "service": true
        },
        "lint": {
            "command": "eslint"
        },
        "type-check": {
            "command": "tsc"
        }
    }
}
