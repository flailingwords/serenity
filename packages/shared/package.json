{
    "dependencies": {
        "@hono/zod-validator": "0.7.6",
        "debug": "4.4.3",
        "hono": "4.12.18",
        "zod": "4.3.6"
    },
    "devDependencies": {
        "@eslint-community/eslint-plugin-eslint-comments": "4.7.1",
        "@tyisi/config-eslint": "6.0.0",
        "@tyisi/config-prettier": "5.0.0",
        "@types/debug": "4.1.13",
        "@types/node": "24.12.2",
        "eslint": "10.2.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-n": "17.24.0",
        "eslint-plugin-promise": "7.2.1",
        "eslint-plugin-react": "7.37.5",
        "globals": "17.5.0",
        "prettier": "3.8.3",
        "prettier-plugin-sh": "0.18.1",
        "prettier-plugin-tailwindcss": "0.7.2",
        "tsup": "8.5.1",
        "typescript": "~5.9.3",
        "wireit": "0.14.12"
    },
    "exports": {
        ".": {
            "types": "./dist/shared.d.ts",
            "import": "./dist/shared.js",
            "require": "./dist/shared.cjs"
        },
        "./data-templates": {
            "types": "./dist/data-templates.d.ts",
            "import": "./dist/data-templates.js",
            "require": "./dist/data-templates.cjs"
        },
        "./lib": {
            "types": "./dist/lib.d.ts",
            "import": "./dist/lib.js",
            "require": "./dist/lib.cjs"
        },
        "./schemas": {
            "types": "./dist/schemas.d.ts",
            "import": "./dist/schemas.js",
            "require": "./dist/schemas.cjs"
        },
        "./types": {
            "types": "./dist/types.d.ts",
            "import": "./dist/types.js",
            "require": "./dist/types.cjs"
        }
    },
    "files": [
        "dist/**"
    ],
    "main": "./dist/shared.cjs",
    "module": "./dist/shared.js",
    "name": "serenity-shared",
    "private": true,
    "scripts": {
        "build": "wireit",
        "lint": "wireit",
        "prepare": "wireit"
    },
    "type": "module",
    "types": "./dist/shared.d.ts",
    "version": "0.0.0",
    "wireit": {
        "build": {
            "dependencies": [
                "type-check",
                "test",
                "build:data-templates:cjs",
                "build:data-templates:esm",
                "build:lib:cjs",
                "build:lib:esm",
                "build:schemas:cjs",
                "build:schemas:esm",
                "build:shared:cjs",
                "build:shared:esm"
            ]
        },
        "build:data-templates:cjs": {
            "clean": true,
            "command": "tsup --format cjs -d dist ./src/data-templates/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/data-templates.cjs"
            ]
        },
        "build:data-templates:esm": {
            "clean": true,
            "command": "tsup --format esm -d dist ./src/data-templates/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/data-templates.mjs"
            ]
        },
        "build:lib:cjs": {
            "clean": true,
            "command": "tsup --format cjs -d dist ./src/lib/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/lib.cjs"
            ]
        },
        "build:lib:esm": {
            "clean": true,
            "command": "tsup --format esm -d dist ./src/lib/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/lib.mjs"
            ]
        },
        "build:schemas:cjs": {
            "clean": true,
            "command": "tsup --format cjs -d dist ./src/schemas/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/schemas.cjs"
            ]
        },
        "build:schemas:esm": {
            "clean": true,
            "command": "tsup --format esm -d dist ./src/schemas/index.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/schemas.mjs"
            ]
        },
        "build:shared:cjs": {
            "clean": true,
            "command": "tsup --format cjs -d dist ./src/shared.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/shared.cjs"
            ]
        },
        "build:shared:esm": {
            "clean": true,
            "command": "tsup --format esm -d dist ./src/shared.ts --dts",
            "dependencies": [
                "type-check",
                "test"
            ],
            "output": [
                "dist/shared.mjs"
            ]
        },
        "lint": {
            "command": "eslint"
        },
        "prepare": {
            "dependencies": [
                "build"
            ]
        },
        "test": {
            "command": "echo TODO"
        },
        "type-check": {
            "command": "tsc --noEmit"
        }
    }
}
